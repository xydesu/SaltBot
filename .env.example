# Discord Bot Token (從 Discord Developer Portal 獲取)
DISCORD_TOKEN=your_bot_token_here

# Bot Client ID (從 Discord Developer Portal 獲取)
CLIENT_ID=your_client_id_here

# Guild ID (可選，用於測試特定伺服器的斜線命令)
GUILD_ID=your_guild_id_here

# maimai DX 帳號設定
MAIMAI_SEGA_ID=your_sega_id_here
MAIMAI_PASSWORD=your_password_here

# 加密金鑰（用於安全儲存用戶的 SEGA 帳號密碼，請設定為強隨機字串）
# 可使用: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_to_a_random_secret_string